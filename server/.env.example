# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/kheti-panel

# Hugging Face User Access Token — used server-side only, never exposed to the client
# Create a fine-grained token with "Make calls to Inference Providers" permission.
HF_TOKEN=hf_your_token_here

# Vision-language model used by disease scanning and AI advisory features
HF_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Port the Express server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your React dev server, prod domain, etc.)
CLIENT_ORIGIN=http://localhost:5173
